# === required ===
BOT_TOKEN=123456:ABC-your-botfather-token
# Supabase → Project Settings → Data API: Project URL + secret (service_role) key
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key
OWNER_ID=your_telegram_id

# === production (morphine.app) ===
WEBAPP_URL=https://morphine.app
WEBHOOK_SECRET=generate-a-long-random-string
INIT_DATA_MAX_AGE_SECONDS=86400

# === local testing (uncomment for localhost) ===
# WEBAPP_URL=http://localhost:8080
# DEV_MODE=1          # auth bypass: browser gets a fake admin user. NEVER set on Vercel!
# DEV_USER_ID=1
